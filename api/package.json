  "scripts": {
    "prebuild": "rimraf dist",
    "build": "nest build",
    "start:dev": "nest start --watch",
    "watch": "source ../scripts/setenv-backend-dev.sh; nest start --watch",
    "watch-env": "source ../scripts/setenv-backend-dev.sh; VAULT_TOKEN=myroot envconsul -config=env.hcl nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "start:queue-worker": "node dist/queue-worker",
    "start:queue-worker:dev": "source ../scripts/setenv-backend-dev.sh; node dist/queue-worker",
    "start:queue-worker-env": "source ../scripts/setenv-backend-dev.sh; VAULT_TOKEN=myroot envconsul -config=env.hcl node dist/queue-worker",
    "typecheck": "tsc --noEmit",
    "typecheck:src": "tsc --noEmit -p tsconfig.build.json",
    "lint": "eslint \"{src,test}/**/*.ts\" eslint.config.mjs",
    "lint:fix": "eslint \"{src,test}/**/*.ts\" eslint.config.mjs --fix",
    "check": "npm run lint && npm run typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:e2e": "vitest run --config ./test/vitest-e2e.config.ts",
    "test:e2e:watch": "vitest --config ./test/vitest-e2e.config.ts"
  },
